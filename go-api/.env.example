# Puerto HTTP del servicio.
PORT=8080

# Endpoint /stats de la API de estadisticas.
# STATS_API_URL=https://inter-express.rejcob.dev/stats
STATS_API_URL=http://host.docker.internal:3001/stats

# Timeout de la llamada a la API de estadisticas ("10s" o segundos).
STATS_API_TIMEOUT=10s

# Origenes permitidos para llamadas desde un navegador, separados por coma.
# "*" acepta cualquiera, que es lo razonable para una API publica sin sesiones.
# Para restringirla al frontend: CORS_ORIGINS=https://goxpres.rejcob.dev
CORS_ORIGINS=*
