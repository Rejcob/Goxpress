# Puerto HTTP del servicio.
# Lo usan tanto la aplicacion como el mapeo de puertos de Docker y el
# healthcheck: cambiarlo aqui los mueve a todos.
PORT=8080

# Endpoint /stats de la API de estadisticas. El valor depende de donde corre
# esta API, porque 'localhost' dentro de un contenedor es el contenedor mismo:
#
#   - En el VPS (esta API en contenedor, la otra detras de su dominio):
STATS_API_URL=https://inter-express.rejcob.dev/stats
#
#   - En local, esta API en contenedor y la API Node publicada en el host:
# STATS_API_URL=http://host.docker.internal:3001/stats
#
#   - En local, esta API corriendo directo con 'go run' (sin Docker):
# STATS_API_URL=http://localhost:3001/stats

# Timeout de la llamada a la API de estadisticas ("10s" o segundos).
STATS_API_TIMEOUT=10s
