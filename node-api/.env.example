# Puerto HTTP del servicio.
# Lo usan tanto la aplicacion como el mapeo de puertos de Docker y el
# healthcheck: cambiarlo aqui los mueve a todos.
PORT=3001

# development | production
NODE_ENV=production

# Tolerancia para considerar un valor como cero al verificar matrices diagonales
ZERO_TOLERANCE=1e-9

# Decimales a los que se redondean las estadisticas de salida
OUTPUT_PRECISION=10

# Tamano maximo del body JSON aceptado.
# Debe coincidir con el client_max_body_size de nginx (ver infra/), o nginx
# rechazaria las matrices grandes con un 413 antes de que la API las vea.
BODY_LIMIT=5mb

# Registrar una linea por peticion HTTP en stdout. "false" lo desactiva.
LOG_REQUESTS=true
